<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reflexion Praktikumstag | Staatliche Regelschule Heimbürgeschule Kahla</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        school: {
                            blue: '#0070BA',
                            darkblue: '#00558F',
                            cyan: '#00A8B5',
                            teal: '#0BB5B5',
                            orange: '#F5931E',
                            orangehover: '#D97A09',
                            lightbg: '#F4F9FD',
                            border: '#D0E4F5'
                        }
                    }
                }
            }
        }
    </script>
    <!-- html2pdf.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        /* PDF specific enhancements */
        .pdf-export-mode {
            box-shadow: none !important;
            border-radius: 0 !important;
            max-width: 100% !important;
            padding: 10px 18px !important;
            background: #ffffff !important;
        }
        .pdf-export-mode .no-print {
            display: none !important;
        }
        .pdf-export-mode input, 
        .pdf-export-mode textarea, 
        .pdf-export-mode select {
            border: 1px solid #cbd5e1 !important;
            background-color: #f8fafc !important;
            color: #0f172a !important;
            box-shadow: none !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        /* Verhindert, dass Fragen im PDF auf zwei Seiten umgebrochen werden */
        .avoid-break {
            page-break-inside: avoid;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-100 via-blue-50/40 to-slate-200 text-slate-800 font-sans antialiased min-h-screen p-3 sm:p-6 md:p-8">

    <div id="app-container" class="max-w-3xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden border border-school-border">
        
        <!-- Header Banner with School Corporate Design -->
        <header class="bg-gradient-to-r from-school-darkblue via-school-blue to-school-cyan p-5 sm:p-7 text-white relative avoid-break">
            <div class="flex flex-row items-center gap-4 sm:gap-6">
                <!-- Base64 Logo -->
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-white p-1.5 rounded-full shadow-lg flex-shrink-0 flex items-center justify-center ring-4 ring-white/30">
                    <img src="data:image/png;base64," alt="Logo Staatliche Regelschule Heimbürgeschule Kahla" class="w-full h-full object-contain rounded-full">
                </div>
                <div class="flex-1">
                    <div class="inline-block bg-school-orange text-white text-[11px] sm:text-xs uppercase font-bold tracking-widest px-2.5 py-0.5 rounded-full shadow-sm mb-1.5">
                        Berufsorientierung & Praxis
                    </div>
                    <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight leading-tight text-white drop-shadow-sm">
                        Reflexion meines Praktikumstages
                    </h1>
                    <p class="text-xs sm:text-sm text-blue-100 font-medium mt-0.5">
                        Staatliche Regelschule »Heimbürgeschule« Kahla
                    </p>
                </div>
            </div>
            <div class="absolute bottom-0 left-0 right-0 h-1.5 bg-school-orange"></div>
        </header>

        <!-- Formular Content -->
        <form id="reflexion-form" class="p-5 sm:p-8 space-y-6">
            
            <!-- Stammdaten Card -->
            <div class="bg-school-lightbg border border-school-border rounded-xl p-4 sm:p-5 shadow-sm avoid-break">
                <h2 class="text-xs font-bold uppercase tracking-wider text-school-blue mb-3 flex items-center">
                    <svg class="w-4 h-4 mr-1.5 text-school-cyan" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path></svg>
                    Angaben zum Praktikumstag
                </h2>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3.5">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Eigener Name <span class="text-school-orange">*</span></label>
                        <input type="text" id="student_name" class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition" placeholder="Vor- und Nachname">
                    </div>
                    
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Firma / Betrieb <span class="text-school-orange">*</span></label>
                        <input type="text" id="company_name" class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition" placeholder="Name des Unternehmens">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Turnus / Etappe <span class="text-school-orange">*</span></label>
                        <select id="stage_select" class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition">
                            <option value="Turnus 1">Turnus 1 (Etappe 1)</option>
                            <option value="Turnus 2">Turnus 2 (Etappe 2)</option>
                            <option value="Turnus 3">Turnus 3 (Etappe 3)</option>
                            <option value="Turnus 4">Turnus 4 (Etappe 4)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Datum <span class="text-school-orange">*</span></label>
                        <input type="date" id="report_date" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Arbeitsbeginn</label>
                        <input type="time" id="start_time" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Arbeitsende</label>
                        <input type="time" id="end_time" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition">
                    </div>
                </div>
            </div>

            <!-- Freitext 1: Tätigkeitsbericht -->
            <div class="space-y-1.5 avoid-break">
                <label class="block text-sm font-bold text-slate-800 flex items-center">
                    <span class="w-5 h-5 rounded-full bg-school-cyan text-white text-xs flex items-center justify-center font-bold mr-2">1</span>
                    Worin bestand deine Tätigkeit an diesem Tag?
                </label>
                <textarea id="task_description" rows="3" class="w-full border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition" placeholder="Beschreibe deine Hauptaufgaben, Werkzeuge, Maschinen oder Arbeitsschritte..."></textarea>
            </div>

            <!-- Freitext 2: Tagesablauf Zeitstunden -->
            <div class="space-y-1.5 avoid-break">
                <label class="block text-sm font-bold text-slate-800 flex items-center">
                    <span class="w-5 h-5 rounded-full bg-school-cyan text-white text-xs flex items-center justify-center font-bold mr-2">2</span>
                    Wie lief dein Praktikumstag ab?
                </label>
                <p class="text-xs text-slate-500 ml-7">Stichpunktartiger Überblick nach Zeitstunden</p>
                <textarea id="daily_schedule" rows="4" class="w-full border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition" placeholder="08:00 Uhr: Arbeitsbeginn, Sicherheitsunterweisung&#10;09:30 Uhr: Vorbereitung der Werkstücke&#10;12:00 Uhr: Mittagspause&#10;12:45 Uhr: Montagearbeiten..."></textarea>
            </div>

            <!-- 4-stufige Skalierung Selbsteinschätzung -->
            <div class="space-y-3 pt-2">
                <label class="block text-sm font-bold text-slate-800 flex items-center border-b border-slate-200 pb-2 avoid-break">
                    <span class="w-5 h-5 rounded-full bg-school-orange text-white text-xs flex items-center justify-center font-bold mr-2">3</span>
                    Selbsteinschätzung & Reflexion (4-stufige Bewertung)
                </label>
                
                <!-- Frage 1 -->
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3 hover:border-school-border transition avoid-break">
                    <span class="text-xs sm:text-sm font-medium text-slate-800 flex-1">• Die Arbeit an diesem Tag hat mir Spaß gemacht.</span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-xs flex-shrink-0 choice-btn">
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_fun" value="trifft voll zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft voll zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_fun" value="trifft eher zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft eher zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_fun" value="trifft eher nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft eher nicht zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_fun" value="trifft gar nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft gar nicht zu</span>
                        </label>
                    </div>
                </div>

                <!-- Frage 2 -->
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3 hover:border-school-border transition avoid-break">
                    <span class="text-xs sm:text-sm font-medium text-slate-800 flex-1">• Ich habe mich während meiner Arbeit gelangweilt.</span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-xs flex-shrink-0 choice-btn">
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_bored" value="trifft voll zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft voll zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_bored" value="trifft eher zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft eher zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_bored" value="trifft eher nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft eher nicht zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_bored" value="trifft gar nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft gar nicht zu</span>
                        </label>
                    </div>
                </div>

                <!-- Frage 3 mit Erläuterung -->
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-3 hover:border-school-border transition avoid-break">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                        <span class="text-xs sm:text-sm font-medium text-slate-800 flex-1">• Ich habe an diesem Tag etwas Neues gelernt.</span>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-xs flex-shrink-0 choice-btn">
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_learned" value="trifft voll zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft voll zu</span>
                            </label>
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_learned" value="trifft eher zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft eher zu</span>
                            </label>
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_learned" value="trifft eher nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft eher nicht zu</span>
                            </label>
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_learned" value="trifft gar nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft gar nicht zu</span>
                            </label>
                        </div>
                    </div>
                    <textarea id="learned_explanation" rows="2" class="w-full bg-white border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition" placeholder="Erläuterung: Welche Fachkenntnisse, Fähigkeiten oder Werkzeuge hast du neu gelernt?"></textarea>
                </div>

                <!-- Frage 4 mit Erläuterung -->
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-3 hover:border-school-border transition avoid-break">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                        <span class="text-xs sm:text-sm font-medium text-slate-800 flex-1">• Ich war mit einer Aufgabe überfordert.</span>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-xs flex-shrink-0 choice-btn">
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_overwhelmed" value="trifft voll zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft voll zu</span>
                            </label>
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_overwhelmed" value="trifft eher zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft eher zu</span>
                            </label>
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_overwhelmed" value="trifft eher nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft eher nicht zu</span>
                            </label>
                            <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                                <input type="radio" name="sc_overwhelmed" value="trifft gar nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                                <span>Trifft gar nicht zu</span>
                            </label>
                        </div>
                    </div>
                    <textarea id="overwhelmed_explanation" rows="2" class="w-full bg-white border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition" placeholder="Erläuterung: Wobei hast du dich überfordert gefühlt und woran lag es?"></textarea>
                </div>

                <!-- Frage 5 -->
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3 hover:border-school-border transition avoid-break">
                    <span class="text-xs sm:text-sm font-medium text-slate-800 flex-1">• Ich kann mir vorstellen, dieser Tätigkeit täglich nachzugehen.</span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 text-xs flex-shrink-0 choice-btn">
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_career" value="trifft voll zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft voll zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_career" value="trifft eher zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft eher zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_career" value="trifft eher nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft eher nicht zu</span>
                        </label>
                        <label class="inline-flex items-center justify-center px-2 py-1.5 rounded-lg border border-slate-300 bg-white cursor-pointer hover:bg-slate-50 transition text-center">
                            <input type="radio" name="sc_career" value="trifft gar nicht zu" class="text-school-blue focus:ring-school-blue mr-1">
                            <span>Trifft gar nicht zu</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Freitext 3: Besondere Erinnerung -->
            <div class="space-y-1.5 pt-2 avoid-break">
                <label class="block text-sm font-bold text-slate-800 flex items-center">
                    <span class="w-5 h-5 rounded-full bg-school-cyan text-white text-xs flex items-center justify-center font-bold mr-2">4</span>
                    Das bleibt mir von diesem Tag besonders in Erinnerung:
                </label>
                <textarea id="special_memory" rows="3" class="w-full border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-school-cyan focus:border-school-cyan focus:outline-none transition" placeholder="Ein besonderes Erlebnis, ein tolles Teamgespräch, eine gelungene Arbeit..."></textarea>
            </div>

            <!-- PDF Timestamp Footer -->
            <div id="pdf-timestamp-box" class="hidden border-t border-slate-200 pt-3 text-[11px] text-slate-500 flex justify-between items-center">
                <span>Staatliche Regelschule Heimbürgeschule Kahla</span>
                <span id="pdf-timestamp-text">Erstellt am: --.--.----, --:-- Uhr</span>
            </div>

            <!-- Action Buttons & Hint -->
            <div class="mt-8 pt-6 border-t border-slate-200 no-print">
                <div class="flex flex-col sm:flex-row gap-3">
                    <button type="button" onclick="generatePDF()" class="flex-1 bg-gradient-to-r from-school-blue to-school-cyan hover:from-school-darkblue hover:to-school-blue text-white font-bold py-3.5 px-6 rounded-xl shadow-lg hover:shadow-xl transition flex justify-center items-center">
                        <svg class="w-5 h-5 mr-2 text-school-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z" clip-rule="evenodd"></path></svg>
                        Tagesbericht als PDF exportieren
                    </button>
                    <button type="button" onclick="clearForm()" class="bg-slate-100 hover:bg-red-50 hover:text-red-600 text-slate-600 font-medium py-3.5 px-6 rounded-xl transition border border-slate-200">
                        Zurücksetzen
                    </button>
                </div>
                
                <!-- Hinweis-Box -->
                <div class="mt-5 p-4 bg-school-lightbg border border-school-border rounded-lg text-xs sm:text-sm text-school-darkblue">
                    <strong>💡 Hinweis zum Download:</strong> Das PDF wird direkt automatisch heruntergeladen. 
                    <ul class="mt-1.5 ml-5 list-disc space-y-0.5">
                        <li><strong>Apple (iPad/iPhone):</strong> Du findest die Datei in der App <em>„Dateien“</em> (im Ordner „Downloads“).</li>
                        <li><strong>Android & PC:</strong> Die Datei landet im Standard-Ordner <em>„Downloads“</em> deines Geräts.</li>
                    </ul>
                </div>
            </div>
            
            <p class="text-center text-xs text-slate-400 mt-4 no-print">Alle Daten werden automatisch und sicher lokal im Browser auf diesem Gerät gespeichert.</p>

        </form>
    </div>

    <script>
        const form = document.getElementById('reflexion-form');
        const inputs = form.querySelectorAll('input:not([type="radio"]), textarea, select');
        const radioGroups = ['sc_fun', 'sc_bored', 'sc_learned', 'sc_overwhelmed', 'sc_career'];

        // 1. Speichern in LocalStorage
        function saveToLocal() {
            const data = {};
            inputs.forEach(input => data[input.id] = input.value);
            radioGroups.forEach(group => {
                const checked = document.querySelector(`input[name="${group}"]:checked`);
                data[group] = checked ? checked.value : '';
            });
            localStorage.setItem('praktikum_reflexion_kahla_final', JSON.stringify(data));
        }

        // 2. Laden aus LocalStorage
        function loadFromLocal() {
            const data = JSON.parse(localStorage.getItem('praktikum_reflexion_kahla_final'));
            if (data) {
                inputs.forEach(input => {
                    if (data[input.id] !== undefined) input.value = data[input.id];
                });
                radioGroups.forEach(group => {
                    if (data[group]) {
                        const targetRadio = document.querySelector(`input[name="${group}"][value="${data[group]}"]`);
                        if (targetRadio) targetRadio.checked = true;
                    }
                });
            }
        }

        // Event-Listener anhängen
        inputs.forEach(input => input.addEventListener('input', saveToLocal));
        radioGroups.forEach(group => {
            document.querySelectorAll(`input[name="${group}"]`).forEach(radio => {
                radio.addEventListener('change', saveToLocal);
            });
        });

        // 3. Formular leeren
        function clearForm() {
            if (confirm('Möchtest du alle Eingaben löschen und einen neuen Bericht beginnen?')) {
                localStorage.removeItem('praktikum_reflexion_kahla_final');
                form.reset();
            }
        }

        // 4. PDF Export - Der Bugfix für fehlende Zeilenumbrüche (Word Wrap)
        function generatePDF() {
            const container = document.getElementById('app-container');
            const studentName = document.getElementById('student_name').value.trim() || 'Schueler';
            const dateVal = document.getElementById('report_date').value || 'Datum';
            const stageVal = document.getElementById('stage_select').value;

            // Zeitstempel generieren
            const now = new Date();
            const dateFormatted = now.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
            const timeFormatted = now.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
            
            const timestampBox = document.getElementById('pdf-timestamp-box');
            const timestampText = document.getElementById('pdf-timestamp-text');
            timestampText.innerText = `Digital exportiert am ${dateFormatted} um ${timeFormatted} Uhr`;
            timestampBox.classList.remove('hidden');

            // --- BUGFIX FÜR ABGESCHNITTENEN TEXT (HTML2CANVAS WRAP BUG) ---
            const textElements = container.querySelectorAll('textarea');
            const replacements = [];

            textElements.forEach(el => {
                // Ein div-Element erzeugen, das sich wie Text verhält (erzwingt saubere Zeilenumbrüche)
                const div = document.createElement('div');
                div.className = el.className;
                
                // Styling für sauberen PDF-Druck anpassen
                div.style.border = 'none';
                div.style.backgroundColor = 'transparent';
                div.style.boxShadow = 'none';
                div.style.height = 'auto';
                div.style.minHeight = el.offsetHeight + 'px';
                div.style.whiteSpace = 'pre-wrap'; // Wichtig: Erhält die Zeilenumbrüche
                div.style.wordWrap = 'break-word'; // Wichtig: Bricht lange Zeilen richtig um
                div.innerText = el.value || ' '; // Verhindert, dass das Layout bei leeren Feldern zusammenfällt

                el.parentNode.insertBefore(div, el);
                el.style.display = 'none'; // Versteckt das originale Feld für den Druck

                replacements.push({ original: el, fakeDiv: div });
            });

            // Scroll-Position zurücksetzen (verhindert leere Startseiten)
            window.scrollTo(0, 0);
            container.classList.add('pdf-export-mode');

            // Dateinamen aufbereiten
            const cleanTurnus = stageVal.replace(/\s+/g, '-');
            const cleanName = studentName.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9_-]/g, '');
            const filename = `${cleanTurnus}_${dateVal}_${cleanName}.pdf`;

            const opt = {
                margin:       [8, 6, 8, 6], 
                filename:     filename,
                image:        { type: 'jpeg', quality: 0.98 },
                pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] },
                html2canvas:  { 
                    scale: 2, 
                    useCORS: true,
                    scrollY: 0,
                    scrollX: 0
                },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(container).save().then(() => {
                container.classList.remove('pdf-export-mode');
                timestampBox.classList.add('hidden');
                
                // Originale Felder wiederherstellen und Fake-Divs löschen
                replacements.forEach(rep => {
                    rep.original.style.display = '';
                    rep.fakeDiv.remove();
                });
            });
        }

        window.onload = loadFromLocal;
    </script>
</body>
</html>